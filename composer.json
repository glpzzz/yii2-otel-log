{
    "name": "glpzzz/yii2-otel-log",
    "description": "ECS single-line JSON log target and request-trace propagation for Yii2",
    "type": "library",
    "keywords": ["yii2", "log", "logging", "json", "ecs", "elastic-common-schema", "observability", "tracing"],
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriel A. López López",
            "email": "glpz@daxslab.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "yiisoft/yii2": "~2.0.14",
        "yiisoft/yii2-httpclient": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5",
        "yiisoft/yii2-coding-standards": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "glpzzz\\otellog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "glpzzz\\otellog\\tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
